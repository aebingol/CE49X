# Copy this file to ".env" and fill in your own API keys.
# Get free keys from:
#   FIRMS:    https://firms.modaps.eosdis.nasa.gov/api/map_key/
#   NewsAPI:  https://newsapi.org/account
#   Guardian: https://open-platform.theguardian.com/access/
#   GNews:    https://gnews.io/dashboard
FIRMS_MAP_KEY=your_firms_map_key_here
NEWS_API_KEY=your_newsapi_key_here
GUARDIAN_API_KEY=your_guardian_key_here
GNEWS_API_KEY=your_gnews_key_here
